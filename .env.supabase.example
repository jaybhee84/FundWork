# Copy this file to .env.supabase and paste your Supabase personal access token.
# Supabase dashboard → avatar → Account preferences → Access Tokens → Generate new token.
# Keep it secret: it can manage your whole Supabase account. .env.supabase is git-ignored.
SUPABASE_ACCESS_TOKEN=sbp_paste_your_token_here

# Gmail SMTP: paste the Google App Password into SMTP_PASS locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clearledger.icsdo2026@gmail.com
SMTP_PASS=
SMTP_ADMIN_EMAIL=clearledger.icsdo2026@gmail.com
SMTP_SENDER_NAME=FundWork
