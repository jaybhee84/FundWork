{
  "name": "fundwork",
  "version": "1.0.0",
  "description": "Local fund accounting and year-end reporting workspace",
  "main": "main.js",
  "scripts": {
    "dev": "node launch.js",
    "start": "node launch.js",
    "test": "node test.js && node coa/test.js",
    "supabase": "node scripts/supabase.js",
    "check": "node --check main.js && node --check preload.js && node --check engine.js && node --check renderer.js && node --check coa/schedule.js && node --check coa/precheck.js && node --check coa/demo-source.js && node --check coa/ui.js && node --check coa/login.js && node --check coa/supabase-source.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "FundWork",
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.fundwork.desktop",
    "productName": "FundWork",
    "win": {
      "icon": "assets/fundwork-3d.ico",
      "target": [
        "nsis"
      ]
    },
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "engine.js",
      "style.css",
      "coa/**/*",
      "supabase/migrations/*.sql",
      "!coa/test*.js",
      "assets/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FundWork"
    },
    "mac": {
      "icon": "assets/fundwork-3d.icns",
      "category": "public.app-category.finance",
      "identity": null,
      "target": [
        "dmg"
      ]
    }
  }
}
